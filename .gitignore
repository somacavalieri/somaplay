# Biblioteca de assets (PDFs de songbooks + imagens de cifras) — ~1.8 GB, fica só local
chords/

# Backups da biblioteca. São dados do usuário, podem passar de 30 MB, e podem conter
# cifras e letras de terceiros — nada disso entra num repositório público.
*.somaplay
bkp/

# Sessões de gravação (Audition) e sobras de trabalho
recordings/
untitled folder/

# Arquivos de sistema do macOS
.DS_Store
**/.DS_Store

# Editores / IDE
.vscode/
.idea/

# Temporários
*.tmp
*.log

# Ferramenta de conversão do songbook do Gil. Os módulos em songs/ carregam a letra
# transcrita das músicas — conteúdo de terceiros, não entra no repositório público.
scripts/gil_songbook/
